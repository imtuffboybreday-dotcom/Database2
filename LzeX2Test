local killing = false

local function DoKill(target, mode)
	if killing then return end
	if not target or not target.Character then
		status.Text = "No target"
		return
	end

	local tRoot = GetRoot(target.Character)
	if not tRoot then
		status.Text = "No root"
		return
	end

	local Character = LocalPlayer.Character
	if not Character or not GetRoot(Character) then
		status.Text = "No character"
		return
	end

	local Tool = Character:FindFirstChildOfClass("Tool") or (LocalPlayer.Backpack and LocalPlayer.Backpack:FindFirstChildOfClass("Tool"))
	if not Tool or not Tool:FindFirstChild("Handle") then
		status.Text = "Butuh Tool!"
		return
	end

	killing = true
	status.Text = mode == "fling" and "FLING..." or "GROUND..."

	local previous = GetRoot(Character).CFrame
	local arm = Character:FindFirstChild("Right Arm") or Character:FindFirstChild("RightHand")
	local root = GetRoot(Character)

	Character.Archivable = true
	local Clone = Character:Clone()
	LocalPlayer.Character = Clone
	task.wait(0.03)
	LocalPlayer.Character = Character
	task.wait(0.03)

	local oldHum = Character:FindFirstChildOfClass("Humanoid")
	if oldHum then
		oldHum:Destroy()
	end
	local Humanoid = Instance.new("Humanoid")
	Humanoid.Parent = Character

	Tool.Parent = LocalPlayer.Backpack
	task.wait(0.01)

	if arm then
		local ArmCFrame = arm.CFrame * CFrame.new(0, -1.5, 0, 1, 0, 0, 0, 0, 1, 0, -1, 0)
		Tool.Grip = ArmCFrame:ToObjectSpace(tRoot.CFrame):Inverse()
	end

	tRoot.Anchored = true
	Tool.Parent = Character

	if Tool:FindFirstChild("Handle") then
		workspace.CurrentCamera.CameraSubject = Tool.Handle
	end

	local forceConn
	local start = tick()
	forceConn = RunService.Heartbeat:Connect(function()
		if not Tool or not Tool.Parent or not tRoot or not tRoot.Parent or tick() - start > 3.5 then
			if forceConn then forceConn:Disconnect() end
			return
		end
		pcall(function()
			if arm and arm.Parent and tRoot and tRoot.Parent then
				local ArmCFrame = arm.CFrame * CFrame.new(0, -1.5, 0, 1, 0, 0, 0, 0, 1, 0, -1, 0)
				Tool.Grip = ArmCFrame:ToObjectSpace(tRoot.CFrame):Inverse()
			end
		end)
		pcall(function()
			if Tool.Parent ~= target.Character then
				Tool.Parent = target.Character
			end
		end)
	end)

	task.wait(0.45)

	if mode == "fling" then
		pcall(function()
			if tRoot and tRoot.Parent then
				tRoot.AssemblyLinearVelocity = Vector3.new(math.random(-220, 220), 160, math.random(-220, 220))
				tRoot.AssemblyAngularVelocity = Vector3.new(100, 100, 100)
				task.wait(0.05)
				tRoot.CFrame = CFrame.new(0, -1200, 0)
				tRoot.AssemblyLinearVelocity = Vector3.new(0, -800, 0)
			end
		end)
		task.wait(0.08)
		tRoot.Anchored = false
	else
		tRoot.Anchored = false

		for _, part in pairs(Character:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = false
			end
		end

		if root then
			root.AssemblyLinearVelocity = Vector3.new(0, -250, 0)
			root.CFrame = root.CFrame * CFrame.new(0, -8, 0)
		end

		task.wait(0.12)
	end

	Humanoid.Health = 0
	LocalPlayer.Character = nil

	if forceConn then
		forceConn:Disconnect()
	end

	LocalPlayer.CharacterAdded:Wait()
	task.wait(0.25)

	local newChar = LocalPlayer.Character
	if newChar and GetRoot(newChar) then
		GetRoot(newChar).CFrame = previous
	end

	status.Text = "Done"
	killing = false
end

